{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Frontend: development server",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["run", "dev", "--", "--port", "3000"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Frontend: typecheck",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["run", "typecheck"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$tsc"
    },
    {
      "label": "Frontend: production build",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["run", "build"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}