{
  "folders": [
    {
      "name": "thesamenot — ολόκληρο το project",
      "path": "."
    }
  ],
  "settings": {
    "typescript.tsdk": "frontend/node_modules/typescript/lib",
    "typescript.enablePromptUseWorkspaceTsdk": true,
    "terminal.integrated.defaultProfile.windows": "thesamenot: Command Prompt",
    "npm.packageManager": "npm",
    "files.exclude": {
      "**/.next": true
    },
    "search.exclude": {
      "**/.next": true,
      "**/node_modules": true,
      "**/test-results": true
    },
    "files.watcherExclude": {
      "**/.next/**": true
    },
    "terminal.integrated.profiles.windows": {
      "thesamenot: Command Prompt": {
        "path": "${env:windir}\\System32\\cmd.exe",
        "args": [
          "/d"
        ]
      }
    },
    "terminal.integrated.automationProfile.windows": {
      "path": "${env:windir}\\System32\\cmd.exe",
      "args": [
        "/d"
      ]
    },
    "terminal.integrated.cwd": "${workspaceFolder}/frontend"
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Next.js: Start frontend",
        "type": "node",
        "request": "launch",
        "program": "${workspaceFolder}/frontend/node_modules/next/dist/bin/next",
        "args": [
          "dev",
          "--hostname",
          "127.0.0.1",
          "--port",
          "3000"
        ],
        "cwd": "${workspaceFolder}/frontend",
        "runtimeArgs": [
          "--inspect"
        ],
        "console": "internalConsole",
        "outputCapture": "std",
        "skipFiles": [
          "<node_internals>/**"
        ],
        "env": {
          "API_INTERNAL_URL": "http://127.0.0.1:5080",
          "NEXT_PUBLIC_SITE_URL": "http://localhost:3000"
        },
        "serverReadyAction": {
          "action": "openExternally",
          "pattern": "- Local:.+(https?://[^\\s\\u001b]+)",
          "uriFormat": "%s"
        },
        "internalConsoleOptions": "openOnSessionStart"
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Frontend: development server",
        "type": "shell",
        "command": "npm.cmd",
        "args": [
          "run",
          "dev",
          "--",
          "--port",
          "3000"
        ],
        "options": {
          "cwd": "${workspaceFolder}/frontend"
        },
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated"
        }
      },
      {
        "label": "Frontend: typecheck",
        "type": "shell",
        "command": "npm.cmd",
        "args": [
          "run",
          "typecheck"
        ],
        "options": {
          "cwd": "${workspaceFolder}/frontend"
        },
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": "$tsc"
      },
      {
        "label": "Frontend: production build",
        "type": "shell",
        "command": "npm.cmd",
        "args": [
          "run",
          "build"
        ],
        "options": {
          "cwd": "${workspaceFolder}/frontend"
        },
        "problemMatcher": []
      }
    ]
  }
}
