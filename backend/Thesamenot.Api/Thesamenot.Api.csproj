<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.4" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Stripe.net" Version="53.0.0" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <Content Include="Database/schema.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Database/Migrations/*.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Media/*.mjs" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
