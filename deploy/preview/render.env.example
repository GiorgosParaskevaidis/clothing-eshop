# NON-SECRET template only. Enter real values in Render's environment settings.
# Service: Web Service; Language: Docker; Instance: Free; Region: Frankfurt
# Dockerfile: deploy/preview/Dockerfile; Docker context: repository root
# Health check: /api/health; Auto-deploy: disabled during initial setup
ConnectionStrings__Store=Server=YOUR_FILESS_HOST;Port=YOUR_FILESS_PORT;Database=YOUR_NEW_PREVIEW_DATABASE;User ID=YOUR_DATABASE_USER;Password=YOUR_DATABASE_PASSWORD;SslMode=VerifyFull;MaximumPoolSize=3;
Admin__Email=admin@thesamenot.preview
Admin__PasswordHash=YOUR_SEPARATE_PREVIEW_ADMIN_HASH
Database__Initialize=false
ASPNETCORE_ENVIRONMENT=Preview

# For an explicitly trusted self-signed certificate: SslMode=Required and this pin.
# Never use Required alone for the public database.
# Database__ServerCertificateSha256=<trusted-64-hex-fingerprint>
